# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # Twilio number the call is placed from
TARGET_PHONE_NUMBER=+18054398008

# Deepgram (STT + TTS)
DEEPGRAM_API_KEY=

# Groq (persona engine + bug analysis)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b   # verify with client.models.list(); Groq's catalogue changes

# Publicly reachable wss:// URL Twilio streams audio to (e.g. via ngrok)
PUBLIC_WS_URL=

# --- Turn-taking tuning (all optional; the shipped defaults are in the code) ---
# Silence Deepgram waits for before declaring `speech_final`. Below ~500ms it fires
# on the agent's mid-sentence breath and the patient answers half a question.
DEEPGRAM_ENDPOINTING_MS=800
# End-of-turn backstop. Must stay well above DEEPGRAM_ENDPOINTING_MS or it becomes a
# second mid-sentence trigger rather than a backstop.
DEEPGRAM_UTTERANCE_END_MS=1500
# How long the agent must be quiet before the patient answers, in seconds.
AGENT_QUIET_S=1.0
# The same wait, but after DEEPGRAM_UTTERANCE_END_MS already proved the agent was
# silent for 1.5s. Waiting the full AGENT_QUIET_S again on top of that double-counts
# the same silence and is what made the patient answer ~4s late. speech_final turns,
# which have only seen DEEPGRAM_ENDPOINTING_MS, still pay the full AGENT_QUIET_S.
AGENT_QUIET_AFTER_UTTERANCE_END_S=0.5
# Extra quiet window granted when the agent's line ended mid-sentence.
UNFINISHED_QUIET_S=1.2
# Minimum pause between the agent finishing and the patient starting. Raise this if
# the patient still sounds like it is cutting in.
MIN_GAP_BEFORE_SPEAK_S=0.25
# How long to let the clinic's greeting finish before the patient speaks. The wait
# exits early as soon as the greeting ends in a question, so this only bounds
# greetings that trail off without one.
OPENING_SETTLE_S=4.0
# Hard ceiling on a single call, enforced by Twilio (src/orchestrator.py).
MAX_CALL_SECONDS=180
# When the patient starts closing the conversation, so the goodbye finishes playing
# before MAX_CALL_SECONDS cuts the line. Keep comfortably below MAX_CALL_SECONDS.
WRAP_UP_AT_S=150
# Groq's gpt-oss models are REASONING models and reasoning tokens count against
# max_tokens. Left at the defaults, reasoning ate the entire budget and the patient
# returned an empty line. Set to "none" to disable the parameter entirely.
GROQ_REASONING_EFFORT=low
GROQ_ANALYSIS_REASONING_EFFORT=medium
# Token budget per patient line. This does not make the patient chattier — the spoken
# length is capped separately by MAX_REPLY_CHARS — it only stops reasoning starving
# the reply before it exists.
MAX_COMPLETION_TOKENS=512
# Persona sampling temperature. This is a facts-recital task; above ~0.4 the model
# drifts on details and intermittently returns nothing at all.
PERSONA_TEMPERATURE=0.3
